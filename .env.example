# Public site URL (set this to the real custom domain when connected)
NEXT_PUBLIC_SITE_URL=https://vaphia-website.vercel.app

# Social profiles
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@vaphia
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@vaphia
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/vaphiaa/

# Search engine verification (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Supabase CMS / Admin (optional until admin is configured)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Owner admin password (used when Supabase is not configured). Dev default only — set a real secret in Vercel.
ADMIN_PASSWORD=vaphia-owner-dev
